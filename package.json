{
  "name": "subs-translator",
  "version": "0.1.0",
  "description": "Translate .srt subtitles cue-by-cue with film context, a synopsis, and a name glossary against an OpenAI-compatible endpoint",
  "type": "module",
  "bin": {
    "subs-translate": "bin/subs-translate.ts"
  },
  "main": "bin/subs-translate.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm test",
    "build:binary": "bun build --compile --target=bun-linux-x64 bin/subs-translate.ts --outfile dist/subs-translate-linux-x64",
    "build:binary:linux-musl": "bun build --compile --target=bun-linux-x64-musl bin/subs-translate.ts --outfile dist/subs-translate-linux-x64-musl",
    "build:binary:windows": "bun build --compile --target=bun-windows-x64 bin/subs-translate.ts --outfile dist/subs-translate-windows-x64.exe",
    "build:binary:mac": "bun build --compile --target=bun-darwin-x64 bin/subs-translate.ts --outfile dist/subs-translate-darwin-x64",
    "build:binary:all": "npm run build:binary && npm run build:binary:linux-musl && npm run build:binary:windows && npm run build:binary:mac"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "subtitles",
    "srt",
    "translation"
  ],
  "license": "MIT",
  "dependencies": {
    "openai": "^5.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
