{
  "name": "subs-translator",
  "version": "0.1.0",
  "description": "Translate .srt subtitles cue-by-cue with film context, a synopsis, and a name glossary against an OpenAI-compatible endpoint",
  "type": "module",
  "bin": {
    "subs-translate": "bin/subs-translate.ts"
  },
  "main": "bin/subs-translate.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "subtitles",
    "srt",
    "translation"
  ],
  "license": "MIT",
  "dependencies": {
    "openai": "^5.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
